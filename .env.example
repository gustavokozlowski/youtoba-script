# Servidor
PORT=3000

# YouTube Data API v3 (Google Cloud Console)
API_KEY=
CLIENT_ID=
CLIENT_SECRET_KEY=
# Precisa ser idêntica à URI autorizada no Google Cloud Console.
# O callback do OAuth é tratado em GET /auth
REDIRECT_URL=http://localhost:3000/auth

# Para onde o login volta depois do Google (opcional). Padrão: a interface servida pelo próprio
# servidor (/). Use http://localhost:5173/ quando estiver mexendo na interface com `npm run dev:web`.
# WEB_URL=

# Liga rotas de desenvolvimento (ex.: POST /dev/seed-test-playlist). Deixe false no dia a dia.
ENABLE_DEV_ROUTES=false

# Chave para cifrar o refresh token salvo em disco (32 bytes em base64). Gere com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Onde fica o banco SQLite com o token (opcional)
# TOKEN_DB_PATH=data/youtoba.db

# Pasta dos backups gravados antes de cada remoção (opcional)
# BACKUP_DIR=backups

# Quota diária do projeto no Google Cloud, usada nas estimativas (opcional)
# YOUTUBE_DAILY_QUOTA=10000

# Nível dos logs do servidor (opcional): fatal, error, warn, info, debug, trace ou silent.
# LOG_LEVEL=info
