{
    "root": true,
    "$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
    // Respeita o .gitignore: dist/, web/dist/, node_modules/, data/ e backups/ nunca são checados.
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "src/**/*.ts",
            "test/**/*.ts",
            "web/src/**/*.{ts,tsx,css}",
            "web/vite.config.ts",
            "web/scripts/**/*.cjs",
            "vitest.config.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        // Todas as regras recomendadas valem, inclusive noExplicitAny: erro desconhecido é `unknown`
        // lido por httpErrorLike/errorMessage (src/utils/errors.ts), nunca `any`.
        "rules": {
            "recommended": true,
            "style": {
                // Import só de tipo vira `import type`: some do JS gerado e deixa claro o que é tipo.
                "useImportType": "on"
            }
        }
    },
    // Direção das dependências (ADR 0001): a infraestrutura e o que é compartilhado não conhecem o domínio.
    "overrides": [
        {
            "includes": ["src/infra/**", "src/shared/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": [
                                            "**/modules/**",
                                            "**/services/**",
                                            "**/controllers/**",
                                            "**/routes/**",
                                            "**/server/**"
                                        ],
                                        "message": "infra/ e shared/ não importam o domínio nem o servidor (ADR 0001)."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/shared/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": [
                                            "**/infra/**",
                                            "**/config/**",
                                            "**/modules/**",
                                            "**/services/**",
                                            "**/controllers/**",
                                            "**/routes/**",
                                            "**/server/**"
                                        ],
                                        "message": "shared/ não depende de nada do projeto (ADR 0001)."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["web/src/shared/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["**/features/**", "**/app/**"],
                                        "message": "shared/ não importa features/ nem app/ (ADR 0001)."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["web/src/features/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": [
                                            "**/features/**",
                                            "**/app/**",
                                            "../auth/**",
                                            "../playlists/**",
                                            "../review/**",
                                            "../removal/**"
                                        ],
                                        "message": "Uma feature não importa o interior de outra feature (ADR 0001)."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
