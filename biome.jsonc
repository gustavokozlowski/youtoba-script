{
    "root": true,
    "$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
    // Respeita o .gitignore: dist/, web/dist/, node_modules/, data/ e backups/ nunca são checados.
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "src/**/*.ts",
            "test/**/*.ts",
            "web/src/**/*.{ts,tsx,css}",
            "web/vite.config.ts",
            "web/scripts/**/*.cjs",
            "vitest.config.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        // Todas as regras recomendadas valem, inclusive noExplicitAny: erro desconhecido é `unknown`
        // lido por httpErrorLike/errorMessage (src/utils/errors.ts), nunca `any`.
        "rules": {
            "recommended": true,
            "style": {
                // Import só de tipo vira `import type`: some do JS gerado e deixa claro o que é tipo.
                "useImportType": "on"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
