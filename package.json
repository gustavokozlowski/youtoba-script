{
  "name": "script",
  "version": "1.0.0",
  "main": "dist/server/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && vite build --config web/vite.config.ts",
    "start": "node dist/server/index.js",
    "dev": "ts-node-dev --no-warnings --respawn --ignore-watch node_modules --transpile-only src/server/index.ts",
    "test": "vitest run",
    "biome:format": "npx @biomejs/biome format",
    "biome:lint": "npx @biomejs/biome lint",
    "biome:check": "npx @biomejs/biome check",
    "biome:fix": "npx @biomejs/biome check --write",
    "test:watch": "vitest",
    "restore:playlist": "ts-node --transpile-only src/scripts/restore-playlist.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:logo": "node web/scripts/build-logo.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "keywords": [],
  "author": "gustavo kozlowski",
  "license": "ISC",
  "description": "Feito com amor <3",
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/big-shoulders-display": "5.3.0",
    "@googleapis/docs": "^3.3.0",
    "@tanstack/react-query": "5.106.1",
    "axios": "^1.21.1",
    "better-sqlite3": "^11.10.0",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.8.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "nock": "^14.0.17",
    "nodemon": "^3.1.9",
    "opentype.js": "1.3.4",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "7.3.8",
    "vitest": "^3.2.7"
  }
}
